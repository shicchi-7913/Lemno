{
  "name": "lemno",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm styles:types && concurrently --kill-others --names styles,vite \"pnpm styles:types:watch\" \"vite\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm styles:lint",
    "styles:lint": "stylelint \"src/**/*.scss\"",
    "test": "node --test \"src/**/*.test.mjs\"",
    "build": "pnpm styles:types && tsc && vite build",
    "styles:types": "typed-scss-modules \"src/**/*.module.scss\" --exportType default --nameFormat none --implementation sass --banner \"// Generated from SCSS. Do not edit.\"",
    "styles:types:watch": "pnpm styles:types --watch",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "sass": "1.108.0",
    "sass-embedded": "1.108.0",
    "stylelint": "18.0.0",
    "typed-scss-modules": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-store": "2.5.0",
    "i18next": "26.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
