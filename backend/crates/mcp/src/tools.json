[
  {
    "name": "record_conversation",
    "description": "Save a conversation summary, AI feedback, actually used expression IDs and new word/phrase candidates atomically. The conversation remains unreviewed until the learner reads the feedback, checks new expressions to register and saves the review in Lemno. Reuse input.id on retries.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Unique session identifier. Reuse the same ID when retrying this save."
            },
            "topicId": {
              "type": [
                "string",
                "null"
              ],
              "description": "A saved Lemno topic ID, or null when unavailable."
            },
            "ai": {
              "type": "string",
              "enum": [
                "ChatGPT"
              ]
            },
            "durationMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "usedItemIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "description": "IDs of saved expressions the learner actually used. Leave empty when IDs are unavailable."
            },
            "learnedItems": {
              "type": "array",
              "description": "New expression candidates for the learner to review in Lemno. This does not register vocabulary. Include their meanings and examples so the learner can decide.",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "word",
                      "phrase"
                    ],
                    "default": "word"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "exampleText": {
                    "type": "string",
                    "maxLength": 2000,
                    "default": ""
                  }
                },
                "required": [
                  "text",
                  "explanation"
                ],
                "additionalProperties": false
              },
              "maxItems": 100
            },
            "feedback": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "description": "AI feedback grounded in this conversation: strengths, concrete corrections or better phrasing with examples, and what to practice next. Separate this from the factual summary in notes."
            }
          },
          "required": [
            "id",
            "ai",
            "durationMinutes",
            "notes",
            "usedItemIds",
            "learnedItems",
            "feedback"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
